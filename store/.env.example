# Neon PostgreSQL Database
DATABASE_URL=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/dbname?sslmode=require

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# App
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Admin
ADMIN_PASSWORD=your-secure-password-here
ADMIN_SESSION_SECRET=random-long-string-here

# Resend (order confirmation emails)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FROM_EMAIL=PokeCitizen Collectibles <orders@pokecitizencollectibles.com>

# Automatic backups
# Vercel Blob storage token (auto-provided when you add a Blob store in Vercel).
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxx
# Shared secret protecting the /api/admin/backup cron endpoint.
# Vercel Cron automatically sends this as `Authorization: Bearer <CRON_SECRET>`.
# Generate one with: openssl rand -hex 32
CRON_SECRET=your-long-random-cron-secret
