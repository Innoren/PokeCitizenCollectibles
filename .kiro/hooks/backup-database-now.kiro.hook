{
  "enabled": true,
  "name": "Backup Database (read-only)",
  "description": "Runs the safe, read-only db:backup script to save a timestamped JSON snapshot of all cards, orders, and users to ./backups. Never writes to or deletes from the database.",
  "version": "1",
  "when": {
    "type": "userTriggered"
  },
  "then": {
    "type": "runCommand",
    "command": "npm run db:backup",
    "timeout": 120
  }
}